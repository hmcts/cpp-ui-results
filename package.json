{
  "name": "cpp.ui.results",
  "version": "2.51.0-SNAPSHOT",
  "license": "MIT",
  "description": "Hearing Results UI",
  "scripts": {
    "ci:prime": "exit 0",
    "prime": "exit 0",
    "ng": "ng",
    "start": "ng serve",
    "build": "ng build",
    "ci:build": "npm run build:prod",
    "build:prod": "ng build --configuration production",
    "ci:build:prod": "npm run ci:build -- --configuration=production",
    "lint": "ng lint",
    "ci:lint": "mkdirp ./build/lint && npm run lint 1> ./build/lint/tslint-checkstyle-result.xml",
    "test": "ng test --watch",
    "ci:test": "ng run hearing-results:ci-test",
    "sonar:scanner": "sonar-scanner -Dsonar.projectVersion=${version}",
    "sonar:local_verify": "SONAR_SCANNER_OPTS=\"-Dhttp.proxyHost=10.224.23.8 -Dhttp.proxyPort=3128 -Dhttp.nonProxyHosts=localhost|127.0.0.1\" npm run-script sonar:scanner -- -Dsonar.analysis.mode=preview -Dsonar.host.url=http://10.124.22.71:9000 -Dsonar.branch=master",
    "jest-clear-cache": "jest --clearCache",
    "tsc": "tsc --noEmit",
    "code:format": "pretty-quick --staged"
  },
  "husky": {
    "hooks": {
      "pre-commit": "run-s code:format build lint"
    }
  },
  "private": true,
